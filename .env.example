# Copied to .env for local work. Only EXPO_PUBLIC_* values reach the bundle,
# and the app reads them through expo-constants `extra`, never process.env.

# "mock" runs the in-process adapter in src/api/mock. "http" is step 14.
EXPO_PUBLIC_API_MODE=mock

EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SENTRY_DSN=
