{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    // TypeScript 6 does not pull in `node_modules/@types` automatically, so the
    // global packages have to be named. `node` is here for the test suite's
    // `fs` and `__dirname`; app code still reads config through expo-constants
    // and never `process.env` at runtime (§10 of docs/architecture.md).
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // `scripts` is excluded because scripts/runtime-globals.d.ts redeclares
  // globals that lib.dom already provides. It is only ever compiled by
  // tsconfig.runtime.json, where lib.dom is deliberately absent.
  "exclude": ["node_modules", "reference", "ios", "android", "dist", "scripts"]
}
